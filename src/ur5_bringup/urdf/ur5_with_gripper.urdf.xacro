<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro" name="ur5_with_gripper">
  <!-- UR5 arm（ur_description 的 ur_macro，参数透传）-->
  <xacro:include filename="$(find ur_description)/urdf/ur_macro.xacro"/>
  <!-- Lebai gripper（lebai_lm3_support，submodule in-tree）-->
  <xacro:include filename="$(find lebai_lm3_support)/urdf/gripper_macro.xacro"/>

  <xacro:arg name="ur_type" default="ur5"/>
  <xacro:arg name="joint_limit_params" default="$(find ur_description)/config/$(arg ur_type)/joint_limits.yaml"/>
  <xacro:arg name="kinematics_params" default="$(find ur_description)/config/$(arg ur_type)/default_kinematics.yaml"/>
  <xacro:arg name="physical_params" default="$(find ur_description)/config/$(arg ur_type)/physical_parameters.yaml"/>
  <xacro:arg name="visual_params" default="$(find ur_description)/config/$(arg ur_type)/visual_parameters.yaml"/>
  <xacro:arg name="safety_limits" default="true"/>
  <xacro:arg name="safety_pos_margin" default="0.15"/>
  <xacro:arg name="safety_k_position" default="20"/>
  <xacro:arg name="prefix" default=""/>

  <!-- World link for base attachment -->
  <link name="world"/>

  <!-- UR5 arm macro: actual macro name is ur_robot, uses tf_prefix & parent + *origin block -->
  <xacro:ur_robot name="ur" tf_prefix="$(arg prefix)" parent="world"
            joint_limits_parameters_file="$(arg joint_limit_params)"
            kinematics_parameters_file="$(arg kinematics_params)"
            physical_parameters_file="$(arg physical_params)"
            visual_parameters_file="$(arg visual_params)"
            safety_limits="$(arg safety_limits)"
            safety_pos_margin="$(arg safety_pos_margin)"
            safety_k_position="$(arg safety_k_position)">
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </xacro:ur_robot>

  <!-- Lebai gripper macro -->
  <xacro:lebai_gripper prefix="$(arg prefix)"/>

  <!-- gripper 挂到 tool0（LM3 范式：identity origin；若物理有转接件 offset，verify 时调）-->
  <joint name="tool0_to_gripper_base" type="fixed">
    <parent link="$(arg prefix)tool0"/>
    <child link="$(arg prefix)gripper_base_link"/>
    <!-- 转接环 offset：沿 tool0 Z 把夹爪 base 撑离 flange（实测场景 gripper_base 相对
         wrist_3 沿工具轴 +0.01267m，无转角）。先按场景值试，不够再调。 -->
    <origin xyz="0 0 0.01267" rpy="0 0 0"/>
  </joint>

  <!-- 固定 TCP 帧（与 gripper_tip 共位），供 IK / RViz 目标交互球定位。
       tool0→gripper_tip 在任意指角下为纯 Z 平移（3 个 mimic 关节净转角 θ−2θ+θ=0）：
       mount(0.01267) + 0.1056 + 0.0265 + 0.0265 = 0.17127 m。固定 joint=0 DOF，
       arm 规划仍 6-DOF。chain tip 指 gripper_tip_tcp 后，RViz 的目标球就落这里。 -->
  <link name="$(arg prefix)gripper_tip_tcp"/>
  <joint name="tool0_to_gripper_tip_tcp" type="fixed">
    <parent link="$(arg prefix)tool0"/>
    <child link="$(arg prefix)gripper_tip_tcp"/>
    <origin xyz="0 0 0.17127" rpy="0 0 0"/>
  </joint>

  <!-- Orbbec Gemini 2 相机（官方 orbbec_description/urdf/gemini_2.urdf.xacro，eye-in-hand）。
       mount 位姿 = USD 实测（orbbec_gemini_2 相对 flange）：xyz=(0,0,0), rpy=(0,0,-90°)。
       带 mesh + REP-103 光学帧。M7 手眼标定再精修。-->
  <xacro:include filename="$(find orbbec_description)/urdf/gemini_2.urdf.xacro"/>
  <joint name="flange_to_camera_link" type="fixed">
    <parent link="$(arg prefix)flange"/>
    <child link="camera_link"/>
    <origin xyz="0.026 0.028 0.0579" rpy="0 0 0"/>
  </joint>

  <!-- cameraURflangeSupport 转接环（visual only；STL 原始 mm 制，scale 0.001 转 m）-->
  <link name="camera_flange_support">
    <visual>
      <geometry>
        <mesh filename="package://ur5_bringup/meshes/realsenseURflangeSupport.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="flange_support_gray"><color rgba="0.5 0.5 0.5 1"/></material>
    </visual>
  </link>
  <joint name="flange_to_camera_flange_support" type="fixed">
    <parent link="$(arg prefix)flange"/>
    <child link="camera_flange_support"/>
    <origin xyz="0 0 0" rpy="0 0 1.5708"/>
  </joint>
</robot>
