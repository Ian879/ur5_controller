<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro" name="ur5_with_gripper">
  <!--
    SRDF for ur5 + Lebai gripper.
    ur_manipulator group 是本地 fork（内联系统 ur_macro.srdf.xacro 的 group/states/arm
    disable_collisions），唯一改动：chain tip = gripper_tip_tcp（URDF 里加的固定 TCP 帧），
    让 RViz 目标交互球 / IK 目标落在夹爪 tip。arm 仍 6-DOF。
    后面是 Lebai gripper block（group/end_effector/open-closed/disable_collisions），
    group/joint/state 名镜像 lebai_lm3_moveit_config/config/lebai_lm3.srdf。
  -->

  <!-- ===== ur_manipulator: 本地 fork（原 <xacro:include ur.srdf.xacro/> 的 ur_srdf 宏内联）=====
       唯一改动：chain tip 从 tool0 → gripper_tip_tcp（URDF 里加的固定 TCP 帧，与 gripper_tip 共位）。
       这样 MoveIt 的目标交互球 / IK 目标落在夹爪 tip 而非法兰。固定 joint=0 DOF → 仍 6-DOF arm 规划，
       joint_trajectory_controller 仍收 6 arm 关节，组名 ur_manipulator 不变（kinematics/OMPL/servo 不动）。
       不能直接把 tip 设成 gripper_tip——会拖进 3 个 mimic revolute 关节变 9-DOF 炸控制器。 -->
  <group name="ur_manipulator">
    <chain base_link="base_link" tip_link="gripper_tip_tcp" />
  </group>
  <group_state name="home" group="ur_manipulator">
    <!-- 现场二定版（2026-10-29，桌子挪位后手工对准桌面抄录 [116.8,-45.8,35,-89.1,-90,0]°，
         与 demo 的 HOME_JOINTS / UR5_HOME_JOINTS 一致） -->
    <joint name="elbow_joint" value="0.6109" />
    <joint name="shoulder_lift_joint" value="-0.7994" />
    <joint name="shoulder_pan_joint" value="2.0375" />
    <joint name="wrist_1_joint" value="-1.555" />
    <joint name="wrist_2_joint" value="-1.5708" />
    <joint name="wrist_3_joint" value="0" />
  </group_state>
  <group_state name="up" group="ur_manipulator">
    <joint name="elbow_joint" value="0" />
    <joint name="shoulder_lift_joint" value="-0.7854" />
    <joint name="shoulder_pan_joint" value="0" />
    <joint name="wrist_1_joint" value="-1.5707" />
    <joint name="wrist_2_joint" value="0" />
    <joint name="wrist_3_joint" value="0" />
  </group_state>
  <group_state name="test_configuration" group="ur_manipulator">
    <joint name="elbow_joint" value="1.4" />
    <joint name="shoulder_lift_joint" value="-1.62" />
    <joint name="shoulder_pan_joint" value="1.54" />
    <joint name="wrist_1_joint" value="-1.2" />
    <joint name="wrist_2_joint" value="-1.6" />
    <joint name="wrist_3_joint" value="-0.11" />
  </group_state>
  <!-- arm-internal disable_collisions（照搬 ur_macro.srdf.xacro）-->
  <disable_collisions link1="base_link" link2="base_link_inertia" reason="Adjacent" />
  <disable_collisions link1="base_link_inertia" link2="shoulder_link" reason="Adjacent" />
  <disable_collisions link1="tool0" link2="wrist_1_link" reason="Never" />
  <disable_collisions link1="tool0" link2="wrist_2_link" reason="Never" />
  <disable_collisions link1="tool0" link2="wrist_3_link" reason="Adjacent" />
  <disable_collisions link1="forearm_link" link2="upper_arm_link" reason="Adjacent" />
  <disable_collisions link1="forearm_link" link2="wrist_1_link" reason="Adjacent" />
  <disable_collisions link1="shoulder_link" link2="upper_arm_link" reason="Adjacent" />
  <disable_collisions link1="wrist_1_link" link2="wrist_2_link" reason="Adjacent" />
  <disable_collisions link1="wrist_1_link" link2="wrist_3_link" reason="Never" />
  <disable_collisions link1="wrist_2_link" link2="wrist_3_link" reason="Adjacent" />

  <!-- ===== Lebai gripper (from lebai_lm3_moveit_config/config/lebai_lm3.srdf) ===== -->
  <group name="gripper">
    <joint name="gripper_r_joint1"/>
  </group>
  <end_effector name="gripper" parent_link="gripper_tip_tcp" group="gripper" parent_group="ur_manipulator"/>
  <group_state name="open" group="gripper">
    <joint name="gripper_r_joint1" value="1.0471975512"/>
  </group_state>
  <group_state name="closed" group="gripper">
    <joint name="gripper_r_joint1" value="0.0"/>
  </group_state>

  <!-- disable_collisions: copied verbatim from lebai_lm3.srdf (gripper-internal + tool0/gripper_base_link).
       arm-internal pairs (base_link..tool0) are provided by the included ur.srdf.xacro, not duplicated here. -->
  <disable_collisions link1="tool0" link2="gripper_base_link" reason="Adjacent"/>
  <disable_collisions link1="gripper_base_link" link2="gripper_l_link1" reason="Never"/>
  <disable_collisions link1="gripper_base_link" link2="gripper_l_link2" reason="Never"/>
  <disable_collisions link1="gripper_base_link" link2="gripper_l_link_finger" reason="Never"/>
  <disable_collisions link1="gripper_base_link" link2="gripper_r_link1" reason="Never"/>
  <disable_collisions link1="gripper_base_link" link2="gripper_r_link2" reason="Never"/>
  <disable_collisions link1="gripper_base_link" link2="gripper_r_link_finger" reason="Never"/>
  <disable_collisions link1="gripper_l_link1" link2="gripper_l_link2" reason="Never"/>
  <disable_collisions link1="gripper_l_link1" link2="gripper_l_link_finger" reason="Never"/>
  <disable_collisions link1="gripper_l_link1" link2="gripper_r_link1" reason="Never"/>
  <disable_collisions link1="gripper_l_link1" link2="gripper_r_link2" reason="Never"/>
  <disable_collisions link1="gripper_l_link1" link2="gripper_r_link_finger" reason="Never"/>
  <disable_collisions link1="gripper_l_link2" link2="gripper_l_link_finger" reason="Never"/>
  <disable_collisions link1="gripper_l_link2" link2="gripper_r_link1" reason="Never"/>
  <disable_collisions link1="gripper_l_link2" link2="gripper_r_link2" reason="Never"/>
  <disable_collisions link1="gripper_l_link2" link2="gripper_r_link_finger" reason="Never"/>
  <disable_collisions link1="gripper_l_link_finger" link2="gripper_r_link1" reason="Never"/>
  <disable_collisions link1="gripper_l_link_finger" link2="gripper_r_link2" reason="Never"/>
  <disable_collisions link1="gripper_l_link_finger" link2="gripper_r_link_finger" reason="Never"/>
  <disable_collisions link1="gripper_r_link1" link2="gripper_r_link2" reason="Never"/>
  <disable_collisions link1="gripper_r_link1" link2="gripper_r_link_finger" reason="Never"/>
  <disable_collisions link1="gripper_r_link2" link2="gripper_r_link_finger" reason="Never"/>

  <!-- ===== Orbbec 相机：camera_link + camera_botter_screw_frame vs 全部手臂/夹爪 link（刚性挂载，不做自碰撞）===== -->
  <disable_collisions link1="camera_link" link2="base_link" reason="Never"/>
  <disable_collisions link1="camera_link" link2="base_link_inertia" reason="Never"/>
  <disable_collisions link1="camera_link" link2="shoulder_link" reason="Never"/>
  <disable_collisions link1="camera_link" link2="upper_arm_link" reason="Never"/>
  <disable_collisions link1="camera_link" link2="forearm_link" reason="Never"/>
  <disable_collisions link1="camera_link" link2="wrist_1_link" reason="Never"/>
  <disable_collisions link1="camera_link" link2="wrist_2_link" reason="Never"/>
  <disable_collisions link1="camera_link" link2="wrist_3_link" reason="Never"/>
  <disable_collisions link1="camera_link" link2="flange" reason="Never"/>
  <disable_collisions link1="camera_link" link2="tool0" reason="Never"/>
  <disable_collisions link1="camera_link" link2="gripper_base_link" reason="Never"/>
  <disable_collisions link1="camera_link" link2="gripper_r_link1" reason="Never"/>
  <disable_collisions link1="camera_link" link2="gripper_r_link2" reason="Never"/>
  <disable_collisions link1="camera_link" link2="gripper_r_link_finger" reason="Never"/>
  <disable_collisions link1="camera_link" link2="gripper_l_link1" reason="Never"/>
  <disable_collisions link1="camera_link" link2="gripper_l_link2" reason="Never"/>
  <disable_collisions link1="camera_link" link2="gripper_l_link_finger" reason="Never"/>
  <disable_collisions link1="camera_link" link2="gripper_tip_midpoint_arm" reason="Never"/>
  <disable_collisions link1="camera_link" link2="gripper_tip_midpoint_counterarm" reason="Never"/>
  <disable_collisions link1="camera_link" link2="gripper_tip" reason="Never"/>
  <disable_collisions link1="camera_link" link2="camera_flange_support" reason="Adjacent"/>
  <disable_collisions link1="camera_botter_screw_frame" link2="base_link" reason="Never"/>
  <disable_collisions link1="camera_botter_screw_frame" link2="shoulder_link" reason="Never"/>
  <disable_collisions link1="camera_botter_screw_frame" link2="upper_arm_link" reason="Never"/>
  <disable_collisions link1="camera_botter_screw_frame" link2="forearm_link" reason="Never"/>
  <disable_collisions link1="camera_botter_screw_frame" link2="wrist_1_link" reason="Never"/>
  <disable_collisions link1="camera_botter_screw_frame" link2="wrist_2_link" reason="Never"/>
  <disable_collisions link1="camera_botter_screw_frame" link2="wrist_3_link" reason="Never"/>
  <disable_collisions link1="camera_botter_screw_frame" link2="flange" reason="Never"/>
  <disable_collisions link1="camera_botter_screw_frame" link2="tool0" reason="Never"/>
  <disable_collisions link1="camera_botter_screw_frame" link2="gripper_base_link" reason="Never"/>
  <disable_collisions link1="camera_botter_screw_frame" link2="gripper_r_link1" reason="Never"/>
  <disable_collisions link1="camera_botter_screw_frame" link2="gripper_l_link1" reason="Never"/>
  <disable_collisions link1="camera_botter_screw_frame" link2="camera_flange_support" reason="Adjacent"/>
  <!-- 相机内部（相邻 link，不做碰撞）-->
  <disable_collisions link1="camera_link" link2="camera_botter_screw_frame" reason="Adjacent"/>
  <disable_collisions link1="camera_link" link2="camera_depth_frame" reason="Adjacent"/>
  <disable_collisions link1="camera_link" link2="camera_left_ir_frame" reason="Adjacent"/>
  <disable_collisions link1="camera_depth_frame" link2="camera_color_frame" reason="Adjacent"/>
  <disable_collisions link1="camera_depth_frame" link2="camera_right_ir_frame" reason="Adjacent"/>
  <disable_collisions link1="camera_color_frame" link2="camera_color_optical_frame" reason="Adjacent"/>
  <disable_collisions link1="camera_right_ir_frame" link2="camera_right_ir_optical_frame" reason="Adjacent"/>
  <disable_collisions link1="camera_left_ir_frame" link2="camera_left_ir_optical_frame" reason="Adjacent"/>
  <!-- 相机内部非相邻对（刚性整体，全部不自碰撞）-->
  <disable_collisions link1="camera_link" link2="camera_color_frame" reason="Never"/>
  <disable_collisions link1="camera_link" link2="camera_color_optical_frame" reason="Never"/>
  <disable_collisions link1="camera_link" link2="camera_right_ir_frame" reason="Never"/>
  <disable_collisions link1="camera_link" link2="camera_right_ir_optical_frame" reason="Never"/>
  <disable_collisions link1="camera_link" link2="camera_left_ir_optical_frame" reason="Never"/>
  <disable_collisions link1="camera_botter_screw_frame" link2="camera_depth_frame" reason="Never"/>
  <disable_collisions link1="camera_botter_screw_frame" link2="camera_color_frame" reason="Never"/>
  <disable_collisions link1="camera_botter_screw_frame" link2="camera_color_optical_frame" reason="Never"/>
  <disable_collisions link1="camera_botter_screw_frame" link2="camera_right_ir_frame" reason="Never"/>
  <disable_collisions link1="camera_botter_screw_frame" link2="camera_right_ir_optical_frame" reason="Never"/>
  <disable_collisions link1="camera_botter_screw_frame" link2="camera_left_ir_frame" reason="Never"/>
  <disable_collisions link1="camera_botter_screw_frame" link2="camera_left_ir_optical_frame" reason="Never"/>
  <disable_collisions link1="camera_depth_frame" link2="camera_color_optical_frame" reason="Never"/>
  <disable_collisions link1="camera_depth_frame" link2="camera_right_ir_optical_frame" reason="Never"/>
  <disable_collisions link1="camera_depth_frame" link2="camera_left_ir_optical_frame" reason="Never"/>
  <disable_collisions link1="camera_depth_frame" link2="camera_left_ir_frame" reason="Never"/>
  <disable_collisions link1="camera_depth_frame" link2="camera_botter_screw_frame" reason="Never"/>
  <disable_collisions link1="camera_color_frame" link2="camera_right_ir_frame" reason="Never"/>
  <disable_collisions link1="camera_color_frame" link2="camera_right_ir_optical_frame" reason="Never"/>
  <disable_collisions link1="camera_color_frame" link2="camera_left_ir_frame" reason="Never"/>
  <disable_collisions link1="camera_color_frame" link2="camera_left_ir_optical_frame" reason="Never"/>
  <disable_collisions link1="camera_color_frame" link2="camera_botter_screw_frame" reason="Never"/>
  <disable_collisions link1="camera_right_ir_frame" link2="camera_left_ir_frame" reason="Never"/>
  <disable_collisions link1="camera_right_ir_frame" link2="camera_left_ir_optical_frame" reason="Never"/>
  <disable_collisions link1="camera_right_ir_frame" link2="camera_color_optical_frame" reason="Never"/>
  <disable_collisions link1="camera_right_ir_frame" link2="camera_botter_screw_frame" reason="Never"/>
  <disable_collisions link1="camera_right_ir_optical_frame" link2="camera_left_ir_frame" reason="Never"/>
  <disable_collisions link1="camera_right_ir_optical_frame" link2="camera_left_ir_optical_frame" reason="Never"/>
  <disable_collisions link1="camera_right_ir_optical_frame" link2="camera_color_optical_frame" reason="Never"/>
  <disable_collisions link1="camera_right_ir_optical_frame" link2="camera_botter_screw_frame" reason="Never"/>
  <disable_collisions link1="camera_left_ir_frame" link2="camera_color_optical_frame" reason="Never"/>
  <disable_collisions link1="camera_left_ir_frame" link2="camera_botter_screw_frame" reason="Never"/>
  <disable_collisions link1="camera_left_ir_optical_frame" link2="camera_color_optical_frame" reason="Never"/>
  <disable_collisions link1="camera_left_ir_optical_frame" link2="camera_botter_screw_frame" reason="Never"/>
  <disable_collisions link1="camera_color_optical_frame" link2="camera_botter_screw_frame" reason="Never"/>

  <!-- ===== 相机 8 个子帧(color/depth/ir + 各自 optical) vs 全部手臂/夹爪 link：
       刚性挂载在 flange，整组不做自碰撞。之前漏配 → forearm vs camera_left_ir_optical_frame
       等假自碰撞，让 OMPL 判路径 invalid(-2)，运动时灵时不灵。补全。===== -->
  <disable_collisions link1="camera_color_frame" link2="base_link" reason="Never"/>
  <disable_collisions link1="camera_color_frame" link2="base_link_inertia" reason="Never"/>
  <disable_collisions link1="camera_color_frame" link2="shoulder_link" reason="Never"/>
  <disable_collisions link1="camera_color_frame" link2="upper_arm_link" reason="Never"/>
  <disable_collisions link1="camera_color_frame" link2="forearm_link" reason="Never"/>
  <disable_collisions link1="camera_color_frame" link2="wrist_1_link" reason="Never"/>
  <disable_collisions link1="camera_color_frame" link2="wrist_2_link" reason="Never"/>
  <disable_collisions link1="camera_color_frame" link2="wrist_3_link" reason="Never"/>
  <disable_collisions link1="camera_color_frame" link2="flange" reason="Never"/>
  <disable_collisions link1="camera_color_frame" link2="tool0" reason="Never"/>
  <disable_collisions link1="camera_color_frame" link2="gripper_base_link" reason="Never"/>
  <disable_collisions link1="camera_color_frame" link2="gripper_r_link1" reason="Never"/>
  <disable_collisions link1="camera_color_frame" link2="gripper_r_link2" reason="Never"/>
  <disable_collisions link1="camera_color_frame" link2="gripper_r_link_finger" reason="Never"/>
  <disable_collisions link1="camera_color_frame" link2="gripper_l_link1" reason="Never"/>
  <disable_collisions link1="camera_color_frame" link2="gripper_l_link2" reason="Never"/>
  <disable_collisions link1="camera_color_frame" link2="gripper_l_link_finger" reason="Never"/>
  <disable_collisions link1="camera_color_frame" link2="gripper_tip_midpoint_arm" reason="Never"/>
  <disable_collisions link1="camera_color_frame" link2="gripper_tip_midpoint_counterarm" reason="Never"/>
  <disable_collisions link1="camera_color_frame" link2="gripper_tip" reason="Never"/>
  <disable_collisions link1="camera_color_frame" link2="camera_flange_support" reason="Never"/>
  <disable_collisions link1="camera_color_optical_frame" link2="base_link" reason="Never"/>
  <disable_collisions link1="camera_color_optical_frame" link2="base_link_inertia" reason="Never"/>
  <disable_collisions link1="camera_color_optical_frame" link2="shoulder_link" reason="Never"/>
  <disable_collisions link1="camera_color_optical_frame" link2="upper_arm_link" reason="Never"/>
  <disable_collisions link1="camera_color_optical_frame" link2="forearm_link" reason="Never"/>
  <disable_collisions link1="camera_color_optical_frame" link2="wrist_1_link" reason="Never"/>
  <disable_collisions link1="camera_color_optical_frame" link2="wrist_2_link" reason="Never"/>
  <disable_collisions link1="camera_color_optical_frame" link2="wrist_3_link" reason="Never"/>
  <disable_collisions link1="camera_color_optical_frame" link2="flange" reason="Never"/>
  <disable_collisions link1="camera_color_optical_frame" link2="tool0" reason="Never"/>
  <disable_collisions link1="camera_color_optical_frame" link2="gripper_base_link" reason="Never"/>
  <disable_collisions link1="camera_color_optical_frame" link2="gripper_r_link1" reason="Never"/>
  <disable_collisions link1="camera_color_optical_frame" link2="gripper_r_link2" reason="Never"/>
  <disable_collisions link1="camera_color_optical_frame" link2="gripper_r_link_finger" reason="Never"/>
  <disable_collisions link1="camera_color_optical_frame" link2="gripper_l_link1" reason="Never"/>
  <disable_collisions link1="camera_color_optical_frame" link2="gripper_l_link2" reason="Never"/>
  <disable_collisions link1="camera_color_optical_frame" link2="gripper_l_link_finger" reason="Never"/>
  <disable_collisions link1="camera_color_optical_frame" link2="gripper_tip_midpoint_arm" reason="Never"/>
  <disable_collisions link1="camera_color_optical_frame" link2="gripper_tip_midpoint_counterarm" reason="Never"/>
  <disable_collisions link1="camera_color_optical_frame" link2="gripper_tip" reason="Never"/>
  <disable_collisions link1="camera_color_optical_frame" link2="camera_flange_support" reason="Never"/>
  <disable_collisions link1="camera_depth_frame" link2="base_link" reason="Never"/>
  <disable_collisions link1="camera_depth_frame" link2="base_link_inertia" reason="Never"/>
  <disable_collisions link1="camera_depth_frame" link2="shoulder_link" reason="Never"/>
  <disable_collisions link1="camera_depth_frame" link2="upper_arm_link" reason="Never"/>
  <disable_collisions link1="camera_depth_frame" link2="forearm_link" reason="Never"/>
  <disable_collisions link1="camera_depth_frame" link2="wrist_1_link" reason="Never"/>
  <disable_collisions link1="camera_depth_frame" link2="wrist_2_link" reason="Never"/>
  <disable_collisions link1="camera_depth_frame" link2="wrist_3_link" reason="Never"/>
  <disable_collisions link1="camera_depth_frame" link2="flange" reason="Never"/>
  <disable_collisions link1="camera_depth_frame" link2="tool0" reason="Never"/>
  <disable_collisions link1="camera_depth_frame" link2="gripper_base_link" reason="Never"/>
  <disable_collisions link1="camera_depth_frame" link2="gripper_r_link1" reason="Never"/>
  <disable_collisions link1="camera_depth_frame" link2="gripper_r_link2" reason="Never"/>
  <disable_collisions link1="camera_depth_frame" link2="gripper_r_link_finger" reason="Never"/>
  <disable_collisions link1="camera_depth_frame" link2="gripper_l_link1" reason="Never"/>
  <disable_collisions link1="camera_depth_frame" link2="gripper_l_link2" reason="Never"/>
  <disable_collisions link1="camera_depth_frame" link2="gripper_l_link_finger" reason="Never"/>
  <disable_collisions link1="camera_depth_frame" link2="gripper_tip_midpoint_arm" reason="Never"/>
  <disable_collisions link1="camera_depth_frame" link2="gripper_tip_midpoint_counterarm" reason="Never"/>
  <disable_collisions link1="camera_depth_frame" link2="gripper_tip" reason="Never"/>
  <disable_collisions link1="camera_depth_frame" link2="camera_flange_support" reason="Never"/>
  <disable_collisions link1="camera_depth_optical_frame" link2="base_link" reason="Never"/>
  <disable_collisions link1="camera_depth_optical_frame" link2="base_link_inertia" reason="Never"/>
  <disable_collisions link1="camera_depth_optical_frame" link2="shoulder_link" reason="Never"/>
  <disable_collisions link1="camera_depth_optical_frame" link2="upper_arm_link" reason="Never"/>
  <disable_collisions link1="camera_depth_optical_frame" link2="forearm_link" reason="Never"/>
