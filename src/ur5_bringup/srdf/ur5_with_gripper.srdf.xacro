  <disable_collisions link1="camera_depth_optical_frame" link2="wrist_2_link" reason="Never"/>
  <disable_collisions link1="camera_depth_optical_frame" link2="wrist_3_link" reason="Never"/>
  <disable_collisions link1="camera_depth_optical_frame" link2="flange" reason="Never"/>
  <disable_collisions link1="camera_depth_optical_frame" link2="tool0" reason="Never"/>
  <disable_collisions link1="camera_depth_optical_frame" link2="gripper_base_link" reason="Never"/>
  <disable_collisions link1="camera_depth_optical_frame" link2="gripper_r_link1" reason="Never"/>
  <disable_collisions link1="camera_depth_optical_frame" link2="gripper_r_link2" reason="Never"/>
  <disable_collisions link1="camera_depth_optical_frame" link2="gripper_r_link_finger" reason="Never"/>
  <disable_collisions link1="camera_depth_optical_frame" link2="gripper_l_link1" reason="Never"/>
  <disable_collisions link1="camera_depth_optical_frame" link2="gripper_l_link2" reason="Never"/>
  <disable_collisions link1="camera_depth_optical_frame" link2="gripper_l_link_finger" reason="Never"/>
  <disable_collisions link1="camera_depth_optical_frame" link2="gripper_tip_midpoint_arm" reason="Never"/>
  <disable_collisions link1="camera_depth_optical_frame" link2="gripper_tip_midpoint_counterarm" reason="Never"/>
  <disable_collisions link1="camera_depth_optical_frame" link2="gripper_tip" reason="Never"/>
  <disable_collisions link1="camera_depth_optical_frame" link2="camera_flange_support" reason="Never"/>
  <disable_collisions link1="camera_left_ir_frame" link2="base_link" reason="Never"/>
  <disable_collisions link1="camera_left_ir_frame" link2="base_link_inertia" reason="Never"/>
